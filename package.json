{
  "name": "lab-manager-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,web\" -c \"cyan.bold,magenta.bold\" \"npm run dev:server\" \"npm run start --workspace=apps/web\"",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:web": "npm run dev --workspace=apps/web",
    "start:web": "npm run start --workspace=apps/web",
    "build:server": "npm run build --workspace=apps/server",
    "build:web": "npm run build --workspace=apps/web",
    "db:push": "npm run db:push --workspace=apps/server",
    "db:seed": "npm run db:seed --workspace=apps/server",
    "desktop": "electron apps/desktop",
    "desktop:dev": "electron apps/desktop",
    "desktop:dist": "npm run dist --workspace=apps/desktop"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "30.0.1",
    "electron-builder": "^24.13.3"
  }
}
