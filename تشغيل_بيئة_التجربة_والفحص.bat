@echo off
chcp 65001 > nul
title Labryo LIMS - بيئة الفحص والتجربة المعزولة (Staging 3000)
color 0B

echo.
echo ===============================================================================
echo        LABRYO LIMS - بيئة الفحص والتجربة المعزولة (STAGING ENVIRONMENT)
echo ===============================================================================
echo.
echo  [معلومات الأمان والعزل]:
echo  - هذه البيئة مخصصة حصراً لاختبار وفحص الميزات الجديدة فور برمجتها.
echo  - منفذ الفحص: http://localhost:3000
echo  - برنامج سطح المكتب المستقر (منفذ 8080) والرابط السحابي معزولان تماماً.
echo  - لن يتم تطبيق أي تعديل على النسخة الحية إلا بعد فحصك وموافقتك الصريحة.
echo.
echo ===============================================================================
echo.

cd /d "%~dp0"

echo [*] جاري التحقق من خلو المنفذ 3000 من أي عمليات سابقة...
for /f "tokens=5" %%a in ('netstat -aon ^| findstr ":3000" ^| findstr "LISTENING"') do (
    taskkill /F /PID %%a > nul 2>&1
)

echo [*] جاري تشغيل سيرفر التجربة السريع (Next.js Dev Server)...
echo [*] سيفتح المتصفح تلقائياً فور جاهزية السيرفر...
echo.

start "" http://localhost:3000

cd apps\web
call npx next dev -H 0.0.0.0 -p 3000

pause
